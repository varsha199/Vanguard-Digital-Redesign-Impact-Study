            <column caption='Visit Id' datatype='string' name='[visit_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.01l22ap0wo0xzv1cae6ah1ika498].[none:Variation:nk]'>
