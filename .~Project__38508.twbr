  <worksheets>
    <worksheet name='Average Time per Step'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (merged_clients)' name='federated.01l22ap0wo0xzv1cae6ah1ika498' />
          </datasources>
          <datasource-dependencies datasource='federated.01l22ap0wo0xzv1cae6ah1ika498'>
            <column caption='Step Duration per Visit per Step' datatype='integer' name='[Calculation_2709759657412857861]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [visit_id], [process_step] : DATEDIFF(&apos;minute&apos;, MIN([date_time]), MAX([date_time])) }' />
            </column>
            <column datatype='string' name='[Variation]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2709759657412857861]' derivation='Avg' name='[avg:Calculation_2709759657412857861:qk]' pivot='key' type='quantitative' />
