      <datasource-dependencies datasource='federated.01l22ap0wo0xzv1cae6ah1ika498'>
        <column caption='Completion Rate' datatype='real' name='[Calculation_2559170544826728451]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='COUNTD( IF [process_step] = &quot;confirm&quot; THEN [visitor_id] END )&#10;/&#10;COUNTD( [visitor_id] )' />
        </column>
        <column caption='Tenure Bucket' datatype='string' name='[Calculation_2638053907066155009]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [Calculation_2638053907066064896] &lt; 12 THEN &quot;&lt;1 yr&quot;&#10;ELSEIF [Calculation_2638053907066064896] &lt; 60 THEN &quot;1-5 yr&quot;&#10;ELSEIF [Calculation_2638053907066064896] &lt; 120 THEN &quot;5-10 yr&quot;&#10;ELSE &quot;10+ yr&quot; END' />
        </column>
        <column caption='Step Duration Minutes' datatype='integer' name='[Calculation_2638053907067146249]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='DATEDIFF(&#10;    &apos;minute&apos;,&#10;    { FIXED [visit_id], [process_step] : MIN([date_time]) },&#10;    { FIXED [visit_id], [process_step] : MAX([date_time]) }&#10;)' />
        </column>
        <column caption='Backward Step Flag' datatype='integer' name='[Calculation_2776961808108429312]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='IF INDEX() = 1 THEN 0&#10;ELSEIF MIN([Calculation_2638053907066253314]) &lt; LOOKUP(MIN([Calculation_2638053907066253314]), -1) THEN 1&#10;ELSE 0&#10;END'>
            <table-calc ordering-type='Rows' />
          </calculation>
        </column>
        <column caption='Visit Backtrack Flag' datatype='integer' name='[Calculation_3085950964140425217]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='WINDOW_MAX([Calculation_2776961808108429312])'>
            <table-calc ordering-type='Rows' />
          </calculation>
        </column>
        <column caption='Backtrack Rate %' datatype='real' name='[Calculation_3085950964140900354]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='WINDOW_AVG([Calculation_3085950964140425217]) * 100'>
            <table-calc ordering-type='Rows' />
          </calculation>
        </column>
