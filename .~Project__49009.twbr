      <aliases enabled='yes' />
      <column caption='Previous Step Date' datatype='datetime' name='[Calculation_2559170544823070720]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='LOOKUP( MIN([date_time]), -1 )'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Time Spent (seconds)' datatype='integer' name='[Calculation_2559170544823275521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;second&apos;, [Calculation_2559170544823070720], [Calculation_2559170544824774658])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Current Date' datatype='datetime' name='[Calculation_2559170544824774658]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='LOOKUP( MIN([date_time]), 0 )'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Completion Rate' datatype='real' name='[Calculation_2559170544826728451]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [process_step] = &quot;confirm&quot; THEN [visitor_id] END )&#10;/&#10;COUNTD( [visitor_id] )' />
      </column>
      <column caption='Tenure Months' datatype='integer' name='[Calculation_2638053907066064896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[clnt_tenure_yr] * 12 + [clnt_tenure_mnth]' />
      </column>
      <column caption='Tenure Bucket' datatype='string' name='[Calculation_2638053907066155009]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2638053907066064896] &lt; 12 THEN &quot;&lt;1 yr&quot;&#10;ELSEIF [Calculation_2638053907066064896] &lt; 60 THEN &quot;1-5 yr&quot;&#10;ELSEIF [Calculation_2638053907066064896] &lt; 120 THEN &quot;5-10 yr&quot;&#10;ELSE &quot;10+ yr&quot; END' />
      </column>
      <column aggregation='Sum' caption='Step Number' datatype='integer' name='[Calculation_2638053907066253314]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [process_step]&#10;    WHEN &apos;start&apos; THEN 0&#10;    WHEN &apos;step_1&apos; THEN 1&#10;    WHEN &apos;step_2&apos; THEN 2&#10;    WHEN &apos;step_3&apos; THEN 3&#10;    WHEN &apos;confirm&apos; THEN 4&#10;END' />
      </column>
      <column caption='Step Duration Minutes' datatype='integer' name='[Calculation_2638053907067146249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&#10;    &apos;minute&apos;,&#10;    { FIXED [visit_id], [process_step] : MIN([date_time]) },&#10;    { FIXED [visit_id], [process_step] : MAX([date_time]) }&#10;)' />
      </column>
      <column caption='Date time Parsed' datatype='datetime' name='[Calculation_2709759657408090113]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF ISNULL([date_time]) THEN&#10;  NULL&#10;ELSE&#10;  DATEPARSE(&quot;dd/MM/yyyy HH:mm:ss&quot;, TRIM(STR([date_time])))&#10;END' />
      </column>
      <column caption='Step Duration per Visit per Step' datatype='integer' name='[Calculation_2709759657412857861]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [visit_id], [process_step] : DATEDIFF(&apos;minute&apos;, MIN([date_time]), MAX([date_time])) }' />
      </column>
      <column caption='Backward Step Flag' datatype='integer' name='[Calculation_2776961808108429312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LOOKUP(MIN([Calculation_2638053907066253314]), -1) &gt; MIN([Calculation_2638053907066253314])&#10;THEN 1&#10;ELSE 0&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Visit Completed' datatype='integer' name='[Calculation_3012556363876282368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [visit_id] :&#10;    MAX( IF [process_step] = &apos;confirm&apos; THEN 1 ELSE 0 END )&#10;}' />
      </column>
      <column caption='Completion Rate %' datatype='real' name='[Calculation_3012556363876769794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3012556363876282368]) / COUNTD([visit_id]) * 100' />
      </column>
      <column caption='Visit Backtrack Flag' datatype='integer' name='[Calculation_3085950964140425217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MAX([Calculation_2776961808108429312])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Backtrack Rate %' datatype='real' name='[Calculation_3085950964140900354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_3085950964140425217]) * 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
