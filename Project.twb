    <worksheet name='Completion Rate'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (merged_clients)' name='federated.01l22ap0wo0xzv1cae6ah1ika498' />
          </datasources>
          <datasource-dependencies datasource='federated.01l22ap0wo0xzv1cae6ah1ika498'>
            <column caption='Completion Rate' datatype='real' name='[Calculation_2559170544826728451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [process_step] = &quot;confirm&quot; THEN [visitor_id] END )&#10;/&#10;COUNTD( [visitor_id] )' />
            </column>
            <column caption='Tenure Months' datatype='integer' name='[Calculation_2638053907066064896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[clnt_tenure_yr] * 12 + [clnt_tenure_mnth]' />
            </column>
            <column caption='Tenure Bucket' datatype='string' name='[Calculation_2638053907066155009]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2638053907066064896] &lt; 12 THEN &quot;&lt;1 yr&quot;&#10;ELSEIF [Calculation_2638053907066064896] &lt; 60 THEN &quot;1-5 yr&quot;&#10;ELSEIF [Calculation_2638053907066064896] &lt; 120 THEN &quot;5-10 yr&quot;&#10;ELSE &quot;10+ yr&quot; END' />
            </column>
            <column datatype='string' name='[Variation]' role='dimension' type='nominal' />
            <column caption='Clnt Age' datatype='real' name='[clnt_age]' role='measure' type='quantitative' />
            <column caption='Clnt Tenure Mnth' datatype='integer' name='[clnt_tenure_mnth]' role='measure' type='quantitative' />
